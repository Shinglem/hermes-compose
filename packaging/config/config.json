{
  "version": 1,
  "backend": {
    "mode": "local",
    "local": {
      "hermes_dir": "hermes",
      "host": "127.0.0.1",
      "port": 0,
      "token": null,
      "ready_timeout_ms": 90000,
      "extra_args": [],
      "run_cron": true,
      "home_dir": "data/agent"
    },
    "remote": {
      "base_url": "http://127.0.0.1:9119",
      "token": {
        "source": "env_file",
        "value": null
      },
      "connect_timeout_ms": 10000
    }
  },
  "app": {
    "profile": null,
    "data_dir": "data",
    "log_level": "INFO",
    "log": {
      "dir": "logs",
      "keep_days": 14,
      "max_files": 20,
      "also_stderr": true
    },
    "window": {
      "width": 1440,
      "height": 900,
      "min_width": 900,
      "min_height": 600
    },
    "close_to_tray": true,
    "elevate": "never",
    "autostart": "off"
  }
}
